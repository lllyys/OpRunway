# 复制为 .oprunway/real-machine.env 后填写。该目标文件已被 .gitignore 忽略。
# 不要在这里写 token、密码、私钥或真实内网 IP。

# 当前常用 A2/A3 真机编排入口
OPRUNWAY_MACHINE_PROFILE=a3
OPRUNWAY_MACHINE_SSH_HOST=<ssh-config-alias>
OPRUNWAY_MACHINE_EXECUTION=container
OPRUNWAY_MACHINE_CONTAINER=<container-name>
OPRUNWAY_MACHINE_PLUGIN_DIR=<remote-plugin-workdir>
OPRUNWAY_MACHINE_RUNTIME_ENV=<remote-runtime-env-file>
OPRUNWAY_MACHINE_SETENV=<remote-cann-setenv-file>
OPRUNWAY_MACHINE_VENDOR_DIR=<remote-user-vendor-dir>
OPRUNWAY_MACHINE_SOC=ascend910_93
OPRUNWAY_MACHINE_DEVICE=0
# 逗号分隔的远端只读保护根；真实路径只写 ignored 的 real-machine.env。
OPRUNWAY_MACHINE_PROTECTED_ROOTS=<remote-protected-root-1>,<remote-protected-root-2>

# 950 真机；当前为 host 执行形态
OPRUNWAY_A5_SSH_HOST=<ssh-config-alias>
OPRUNWAY_A5_EXECUTION=host
OPRUNWAY_A5_SOC=ascend950
# 远端暂存目录（上传包、解包、跑门用）。必须指向容量足够的数据卷：该机默认的
# home 分区很小且可能已满，往那儿传会直接失败。真实路径只写 ignored 的 real-machine.env。
OPRUNWAY_A5_STAGE_DIR=<remote-stage-dir>
