# 外部克隆的算子仓（~688M、含 14 个嵌套 .git）——被测对象，不入库
/repos/

# 任务书/规格素材（本地输入，不入库）
/spec/

# 真机本地配置：实际主机别名 / 容器名 / 远端路径不入库；只跟踪脱敏模板
/.oprunway/*.env
!/.oprunway/*.env.example
# per-op **输入**产物根（ops_root 缺省落点，见 repo_adapter.ops_root）：
# golden.py / runner.cpp / spec 都是用户侧按算子生成的，不是仓内容。
# 2026-08-05 补：此前只挡了 *.env，taskdoc golden wrapper 因此被误提交过一次。
/.oprunway/ops/

# 本地工具配置：各人自己的 LOC 门限、抽取规则等，不入库
/.claude/*.local.md

# 生成物：bureau gazette / gazette 打包 / 验收跑测产物 / pycache
/gazette/
oprunway-canon-gazette.zip
/reports/
__pycache__/
*.pyc

# nlpm 制品质量 lint 的派生产物：HTML 报告与打分历史，重跑即可再生，不入库。
# 必须带 **/ 前缀：含中间斜杠的模式会被锚到仓根，挡不住 plugin/.claude/ 下的落点。
**/.claude/nlpm-reports/
**/.claude/nlpm-history.json

# 系统
.DS_Store

# Codex CLI 每次调用会在 cwd 落的诊断日志，含 ChatGPT account id，不入库
/error.log

# cc-suite 由 .mcp.json 派生给 grok 的 MCP 投影，机器本地产物，不入库
/.grok/

# 上游标准文档的本地缓存（外部素材，只读参照，不入库）
/.oprunway/cache/

# >>> cc-suite >>>
# cc-suite-schema: 7
# AI assistant local state
.claude/settings.local.json
.claude/CLAUDE.local.md
.claude/*.local.*
CLAUDE.local.md

# Codex CLI — local files, keep checked-in subdirs
.codex/*
!.codex/skills/
!.codex/prompts/
!.codex/hooks.json
!.codex/hooks.cc-suite.json
!.codex/config.toml

# cc-suite-managed symlinks (created by bridge_skills.sh) — derived, not authored
.claude/skills/cc-suite
.agents/skills

# Antigravity workspace MCP config is generated from .mcp.json and may contain
# credentials or machine-specific paths.
.agents/mcp_config.json
.agents/.cc-suite-mcp.provenance.json

# cc-suite tool-profile bridge (grok/opencode/qwen) — derived provenance
# sidecars tracking which MCP servers cc-suite owns. Not authored.
.cc-suite-*.provenance.json

# cc-suite local state — what init created, and the pre-bridge CLAUDE.md backup.
# Machine-local bookkeeping, not shared. Listed file-by-file on purpose:
# .cc-suite/agents/ holds declared advisors and IS meant to be committed.
.cc-suite/provenance
.cc-suite/original-claude.md
# Audit findings files written by /cc-suite:audit and the audit-fix loop —
# per-run working state (findings + fix statuses), not authored content.
.cc-suite/audits/
# <<< cc-suite <<<
