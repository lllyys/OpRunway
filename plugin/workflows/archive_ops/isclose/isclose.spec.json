{
  "op": "IsClose",
  "repo": "ops-math",
  "runner_form": "cpp",
  "hardware": ["Atlas A2", "Atlas A3"],
  "reference": {"type": "tbe", "ref": "内置 aclnnIsClose TBE"},
  "change": {"kind": "semantic", "note": "二进制比较→逻辑值比较（对齐 CPU）"},
  "params_source": "derived_from_reference",
  "params": [
    {"name": "self",  "io": "in",  "dtype": ["float32", "float16"], "noncontiguous": true},
    {"name": "other", "io": "in",  "dtype": ["float32", "float16"], "noncontiguous": true},
    {"name": "rtol",  "io": "attr", "dtype": ["double"], "default": 1e-05},
    {"name": "atol",  "io": "attr", "dtype": ["double"], "default": 1e-08},
    {"name": "equal_nan", "io": "attr", "dtype": ["bool"], "default": false},
    {"name": "out",   "io": "out", "dtype": ["bool"]}
  ],
  "generalize": true,
  "verify_mode": "exact",
  "precision": {"_case_target_note": "本文件**有意不写 `precision.case_target`**，且**不许回填一个数**。它是 `archive_ops/` 的历史案例快照（`plugin/workflows/` 是材料仓、人读案例，不是可跑输入；无任何代码或测试读它），记录的那轮真机验收**早于 `case_target` 这个字段存在**——同目录 `case.md` 只记了裁决（精度 exact 过、性能达标），连实产条数都没留，所以连「照实产条数写」这条退路都没有。2026-08-06 删掉 gen_cases 的缺省 50 后逐份补显式值时，这份**补不出任何依据**：填 50 是编造。要拿本卡当模板起新算子时，照 `skills/acc-spec/references/taskdoc-to-spec.md` 的『case_target 怎么定』现算一个并写清依据——直接复制本文件去跑 gen_cases 会当场 fail-fast，**那正是预期行为**。",
                "oracle": "ascendoptest", "standard": "exact", "tolerance_policy_id": "exact",
                "threshold": 0, "policy": {"kind": "exact", "max_mismatch": 0, "not_settled": false},
                "threshold_source": "AscendOpTest 默认阈值（bool 输出 → 精确逐位）"},
  "perf": {"baseline": "tbe", "target_ratio": 0.95,
           "case_source": "precision_cases",
           "shape_classification": {"metric": "sum_input_bytes", "small_max_bytes": 262144,
                                    "hardware": "Atlas A3"},
           "small_shape_exception": {"text": "<10us 差 3us→仿真图", "when_us_below": 10,
                                     "abs_gap_us_within": 3, "requires": "simulation_plot+analysis"}},
  "task_pr_gaps": []
}
