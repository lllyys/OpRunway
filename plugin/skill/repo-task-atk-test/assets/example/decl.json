{
  "operator_class": "reduction",
  "comparator": "mixed_tolerance_bm",
  "dims": {
    "dtype": [
      "fp16",
      "bf16",
      "fp32",
      "int32"
    ],
    "rank": [
      1,
      2,
      3,
      4,
      5,
      6,
      7,
      8
    ],
    "size_class": [
      "small",
      "medium",
      "large"
    ],
    "reduce_axis_pos": [
      "first",
      "middle",
      "last"
    ],
    "keepdim": [
      true,
      false
    ]
  },
  "dtype_source_excludes": [
    {
      "dtype": "int64",
      "why": "出现在「attr 的 dtype 用 C++ 名」那条提示里，说的是 attr 不是输入张量"
    },
    {
      "dtype": "bool",
      "why": "同上，keepdim 这类 attr 的 C++ 类型名"
    },
    {
      "dtype": "uint32",
      "why": "出现在读冻结输入的提示里，说的是 torch 没有这个类型，不是本算子的输入 dtype"
    }
  ],
  "infeasible": [
    {
      "rank": 1,
      "reduce_axis_pos": "middle",
      "why": "rank1 只有一根轴，没有中间轴位置"
    },
    {
      "rank": 2,
      "reduce_axis_pos": "middle",
      "why": "rank2 只有首尾两根轴，没有中间轴位置"
    }
  ],
  "coverage_policy": {
    "strategy": "anchored_interactions",
    "baseline": {
      "dtype": "fp32",
      "rank": 2,
      "size_class": "medium",
      "reduce_axis_pos": "last",
      "keepdim": false
    },
    "main_effects": [
      "dtype",
      "rank",
      "size_class",
      "reduce_axis_pos",
      "keepdim"
    ],
    "interaction_groups": [],
    "targeted": [
      "empty",
      "single_element"
    ],
    "max_cases": 200
  },
  "axes": [
    "dtype",
    "shape",
    "dim",
    "keepdim"
  ],
  "extract": {
    "dtype": {
      "from": "input_dtype",
      "index": 0
    },
    "shape": {
      "from": "input_shape",
      "index": 0
    },
    "dim": {
      "from": "attr",
      "name": "dim"
    },
    "keepdim": {
      "from": "attr",
      "name": "keepdim"
    }
  },
  "parameters": {
    "input": {
      "element_kind": "tensor",
      "runtime_container": "single",
      "range": [
        -5,
        5
      ]
    },
    "dim": {
      "element_kind": "attr",
      "runtime_container": "single",
      "dtype": "int64_t",
      "combo_key": "dim"
    },
    "keepdim": {
      "element_kind": "attr",
      "runtime_container": "single",
      "dtype": "bool",
      "combo_key": "keepdim"
    }
  },
  "yaml": {
    "name": "torch.sum",
    "aclnn_name": "ReduceSum",
    "version": "v1",
    "api": "reduce",
    "generate": "example_constraint",
    "standard": {
      "acc": "mixed_tolerance_bm",
      "perf": "not_key"
    }
  }
}
