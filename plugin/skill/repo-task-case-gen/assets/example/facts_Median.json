  "constraints": [
    {
      "text": "dim 取值范围 [-self.dimNum, self.dimNum)",
      "source": "opdoc"
    },
    {
      "text": "self 与 valuesOut 数据类型须一致",
      "source": "opdoc"
    },
    {
      "text": "indicesOut 仅支持 INT32 / INT64",
      "source": "opdoc"
    },
    {
      "text": "不支持空张量，self 元素个数为 0 时返回 ACLNN_ERR_PARAM_INVALID",
      "source": "opdoc"
    },
    {
      "text": "dim 维长度支持为 1，退化场景 values 即原值、indices 恒为 0",
      "source": "opdoc"
    },
    {
      "text": "偶数长度取较小的中间值，与 NumPy 取均值不同；indices 取首个出现位置",
      "source": "opdoc"
    },
    {
      "text": "indicesOut 为 nullptr 时切换为全局中位数语义，本轮不覆盖",
      "source": "opdoc"
    }
  ],
